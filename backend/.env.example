# Core
NODE_ENV=production
PORT=4000
DATABASE_URL=postgresql://user:password@host:5432/captain_slabbin
FRONTEND_URL=https://your-shop-domain.com

# Auth — two long random strings (node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=
JWT_REFRESH_SECRET=

# Storefront gate password (Admin → Settings → Storefront can change it later)
SITE_PASSWORD=CSC

# Staff accounts created by the seed. Without a password, a random one is printed once in the deploy log.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=
# false = don't add the demo catalog to an empty database
SEED_DEMO_PRODUCTS=true

# Telegram bot (from @BotFather) that posts invoices, paid orders and new messages
TELEGRAM_BOT_TOKEN=
# Chat/channel id the bot posts to (Admin → Settings → Storefront overrides it)
TELEGRAM_CHAT_ID=

# Public URL of this backend (incoming BlockCypher/Alchemy webhooks)
PUBLIC_URL=

# Crypto — BlockCypher (BTC/LTC/DOGE)
BLOCKCYPHER_TOKEN=
# HD seeds (12-word BIP39). BTC_HD_SEED falls back to ETH_HD_SEED.
BTC_HD_SEED=
ETH_HD_SEED=
# Crypto — Alchemy (ETH)
ALCHEMY_API_KEY=
ALCHEMY_SIGNING_KEY=
ALCHEMY_AUTH_TOKEN=
ALCHEMY_WEBHOOK_ID=
# XMR fallback if not set in Admin → Settings → Crypto
XMR_ADDRESS=

# Uploads / CDN
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CDN_BASE_URL=

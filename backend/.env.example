# Core
NODE_ENV=production
PORT=4000
DATABASE_URL=postgresql://user:password@host:5432/captain_slabbin
FRONTEND_URL=https://your-shop-domain.com

# Auth — two long random strings (node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=
JWT_REFRESH_SECRET=

# Storefront gate password (Admin → Settings → Storefront can change it later)
SITE_PASSWORD=CSC

# Staff accounts, created once by the seed on the first deploy and never touched
# again (change username/password in Admin -> My account). Without a password, a
# random one is printed once in the deploy log. RESET_STAFF_PASSWORDS=true for one
# deploy restores these accounts after a lost password, then remove it.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=
# false = don't add the demo catalog to an empty database
SEED_DEMO_PRODUCTS=true

# Telegram bot: linked from Admin -> Settings -> Telegram bot (paste the token
# there). These are only a fallback when no bot is linked in the admin.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Public URL of this backend (incoming BlockCypher/Alchemy/Telegram webhooks), e.g. https://api.captainslabbin.shop
PUBLIC_URL=

# Crypto — BlockCypher (BTC/LTC/DOGE)
BLOCKCYPHER_TOKEN=
# HD seeds (12-word BIP39). BTC_HD_SEED falls back to ETH_HD_SEED.
BTC_HD_SEED=
ETH_HD_SEED=
# Crypto — Alchemy (ETH)
ALCHEMY_API_KEY=
ALCHEMY_SIGNING_KEY=
ALCHEMY_AUTH_TOKEN=
ALCHEMY_WEBHOOK_ID=
# XMR fallback if not set in Admin → Settings → Crypto
XMR_ADDRESS=

# Uploads / CDN
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CDN_BASE_URL=

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── USERS ────────────────────────────────────────────────────────────────────

model User {
  id               Int       @id @default(autoincrement())
  username         String    @unique
  passwordHash     String
  role             String    @default("customer")  // customer | moderator | admin | superadmin
  isActive         Boolean   @default(true)
  // Legacy USD balance, only read by scripts/convert-balances-to-crypto.js.
  // The live balance is WalletHolding (crypto) valued at market price.
  balance          Decimal   @default(0) @db.Decimal(12, 2)
  points           Int       @default(0)
  totalSpent       Decimal   @default(0) @db.Decimal(12, 2)
  markupPct        Decimal   @default(0) @db.Decimal(5, 2)
  bio              String?
  telegramHandle   String?
  // Telegram user id, set when the account is opened or connected from the shop's bot
  telegramId       String?   @unique
  // The bot this customer last used: their Telegram messages go out through it
  telegramBotId    Int?
  telegramBot      TelegramBot? @relation(fields: [telegramBotId], references: [id], onDelete: SetNull)
  // Cart of the "commands" bots: [{ productId, option, qty, note }], paid from the wallet at /cart
  telegramCart     Json      @default("[]")
  // Checkout of a "commands" bot in progress: { voucher, name, street, address, last: { name, street, address } }
  telegramCheckout Json?
  signalDetails    String?
  sessionDetails   String?
  btcRefundAddress String?
  xmrRefundAddress String?
  avatarUrl        String?
  hidePrices       Boolean   @default(false)
  notifOrders      Boolean   @default(true)
  notifDeposits    Boolean   @default(true)
  notifTickets     Boolean   @default(true)
  notifNewProducts Boolean   @default(true)
  notifLogins      Boolean   @default(true)
  tourCompleted    Boolean   @default(false)
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  orders         Order[]
  transactions   Transaction[]
  deposits       Deposit[]
  tickets        SupportTicket[]
  ticketMessages TicketMessage[]
  apiKeys        ApiKey[]
  notifications  Notification[]
  reviews        Review[]
  sweepLogs      SweepLog[]
  holdings       WalletHolding[]
  messages       Message[]          @relation("MessageThread")
  sentMessages   Message[]          @relation("MessageSender")
  invoices       TelegramInvoice[]
  pushSubscriptions PushSubscription[]
}

// A staff browser that enabled notifications in the admin (one row per browser)
model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

// Crypto quantity a customer holds per currency, net of the deposit commission.
// The USD balance shown is amount × live price, summed over currencies.
model WalletHolding {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currency  String
  amount    Decimal  @default(0) @db.Decimal(18, 8)
  updatedAt DateTime @updatedAt

  @@unique([userId, currency])
}

// ─── PRODUCTS & CATALOGUE ─────────────────────────────────────────────────────

model Category {
  id        Int        @id @default(autoincrement())
  name      String
  slug      String     @unique
  parentId  Int?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  products  Product[]
  imageUrl  String?    // wide banner shown on the home shelf grid
  position  Int        @default(0)
  // null = the shop's own shelf; otherwise the catalog it belongs to (e.g. "qt"),
  // shown only by the bots whose style names that catalog, never on the site
  source    String?
  createdAt DateTime   @default(now())
}

model Brand {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  slug      String    @unique
  logoUrl   String?
  products  Product[]
  createdAt DateTime  @default(now())
}

model Product {
  id          Int            @id @default(autoincrement())
  name        String
  slug        String         @unique
  sku         String?        @unique
  // Strike-through price: a product with compareAtPrice > price is on the Fire Sale shelf
  compareAtPrice Decimal?    @db.Decimal(10, 2)
  unitLabel   String?        // e.g. "per lb", "per unit", "per 10 pack"
  // Priced packs a customer picks from: [{ label, price }], e.g. "1x" $8.50, "25x" $200.
  // Empty = the product has one price. When set, `price` is the first option's.
  options     Json           @default("[]")
  // null = the shop's own product; otherwise the catalog it belongs to (see Category.source)
  source      String?
  badge       String?        // short card tag, e.g. "New", "Top Shelf"
  isFeatured  Boolean        @default(false)
  description String?
  price       Decimal        @db.Decimal(10, 2)
  stock       Int            @default(0)
  isActive    Boolean        @default(true)
  categoryId  Int?
  category    Category?      @relation(fields: [categoryId], references: [id])
  brandId     Int?
  brand       Brand?         @relation(fields: [brandId], references: [id])
  images      ProductImage[]
  orderItems  OrderItem[]
  reviews     Review[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  thumbnail String?
  position  Int     @default(0)
  mediaType String  @default("image")  // image | video
}

// ─── ORDERS ───────────────────────────────────────────────────────────────────

model Order {
  id              Int         @id @default(autoincrement())
  orderNumber     String      @unique
  userId          Int
  user            User        @relation(fields: [userId], references: [id])
  status          String      @default("processing")  // processing | shipped | delivered | cancelled | refunded
  paymentMethod   String
  totalAmount     Decimal     @db.Decimal(10, 2)
  shippingFee     Decimal     @default(0) @db.Decimal(10, 2)
  shippingAddress String
  name            String
  email           String?
  trackingNumber  String?
  carrier         String?
  note            String?
  // Voucher used at checkout and what it took off the products
  voucherCode     String?
  discount        Decimal     @default(0) @db.Decimal(10, 2)
  // Crypto debited at checkout, frozen: [{ currency, amount, rate, usd }]
  payments        Json        @default("[]")
  placedAt        DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  items           OrderItem[]
  transaction     Transaction?
}

// Voucher codes typed at checkout: an amount or a percentage off the products
model Voucher {
  id        Int       @id @default(autoincrement())
  code      String    @unique              // stored in capitals
  kind      String    @default("percent")  // percent | amount
  value     Decimal   @db.Decimal(10, 2)
  minOrder  Decimal   @default(0) @db.Decimal(10, 2)
  maxUses   Int?                           // null = unlimited
  uses      Int       @default(0)
  expiresAt DateTime?
  isActive  Boolean   @default(true)
  // Catalog it applies to: null = the shop's own, or a Product `source` (e.g. 'qt')
  source    String?
  createdAt DateTime  @default(now())
}

model OrderItem {
  id        Int      @id @default(autoincrement())
  orderId   Int
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int?
  product   Product? @relation(fields: [productId], references: [id])
  name      String
  price     Decimal  @db.Decimal(10, 2)
  quantity  Int
}

// ─── WALLET ───────────────────────────────────────────────────────────────────

model Deposit {
  id              Int          @id @default(autoincrement())
  userId          Int
  user            User         @relation(fields: [userId], references: [id])
  currency        String       // BTC | LTC | DOGE | ETH | XMR
  address         String       @default("pending")
  status          String       @default("awaiting")  // awaiting | partial | confirmed | expired
  amountExpected  Decimal?     @db.Decimal(18, 8)
  amountReceived  Decimal      @default(0) @db.Decimal(18, 8)
  usdCredited     Decimal      @default(0) @db.Decimal(10, 2)
  // Commission is taken when the deposit is credited: the customer gets netAmount,
  // the super admin's reserve gets commissionAmount. Each share is swept separately.
  commissionPct    Decimal     @default(0) @db.Decimal(5, 2)
  commissionAmount Decimal     @default(0) @db.Decimal(18, 8)
  netAmount        Decimal     @default(0) @db.Decimal(18, 8)
  shopSweptAt      DateTime?
  shopSweepTx      String?
  reserveSweptAt   DateTime?
  reserveSweepTx   String?
  expiresAt       DateTime
  confirmedAt     DateTime?
  hookId          String?
  ethIndex        Int?
  transactionId   Int?         @unique
  transaction     Transaction? @relation(fields: [transactionId], references: [id])
  createdAt       DateTime     @default(now())
}

model Transaction {
  id         Int      @id @default(autoincrement())
  frontendId String   @unique
  userId     Int
  user       User     @relation(fields: [userId], references: [id])
  type       String   // deposit | purchase | refund | adjustment | bonus
  amount     Decimal  @db.Decimal(10, 2)
  currency   String   @default("USD")
  status     String   @default("confirmed")  // pending | confirmed | failed
  note       String?
  txHash     String?
  // Crypto side of the movement (signed like `amount`) and the USD price used
  cryptoAmount Decimal? @db.Decimal(18, 8)
  rate         Decimal? @db.Decimal(18, 8)
  orderId    Int?     @unique
  order      Order?   @relation(fields: [orderId], references: [id])
  deposit    Deposit?
  createdAt  DateTime @default(now())
}

// One row per swept deposit address. kind: 'shop' (admin sweep of the
// customer-credited share), 'reserve' (super admin sweep of deposit commissions)
// or 'legacy' (old single sweep that split on-chain).
model SweepLog {
  id                Int      @id @default(autoincrement())
  kind              String   @default("legacy")
  currency          String
  commissionPct     Decimal  @db.Decimal(5, 2)
  totalAmount       Decimal  @db.Decimal(18, 8)
  mainAmount        Decimal  @db.Decimal(18, 8)
  mainAddress       String
  mainTxHash        String?
  commissionAmount  Decimal  @db.Decimal(18, 8)
  commissionAddress String
  commissionTxHash  String?
  addressCount      Int      @default(0)
  triggeredBy       Int?
  createdAt         DateTime @default(now())

  triggeredByUser User? @relation(fields: [triggeredBy], references: [id], onDelete: SetNull)

  @@index([currency])
  @@index([createdAt])
}

// ─── SUPPORT ──────────────────────────────────────────────────────────────────

model SupportTicket {
  id         Int             @id @default(autoincrement())
  frontendId String          @unique
  userId     Int
  user       User            @relation(fields: [userId], references: [id])
  subject    String
  category   String          @default("other")  // deposit | order | account | other
  priority   String          @default("normal") // low | normal | high | urgent
  status     String          @default("open")   // open | in_progress | resolved | closed
  assignedTo String?
  messages   TicketMessage[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
}

model TicketMessage {
  id        Int           @id @default(autoincrement())
  ticketId  Int
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId    Int
  user      User          @relation(fields: [userId], references: [id])
  isAdmin   Boolean       @default(false)
  message   String
  createdAt DateTime      @default(now())
}

// ─── NOTIFICATIONS ────────────────────────────────────────────────────────────

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  type      String   // welcome | order | deposit | ticket | system
  title     String
  message   String
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
}

// ─── CONTENT ──────────────────────────────────────────────────────────────────

model NewsArticle {
  id          Int       @id @default(autoincrement())
  title       String
  slug        String    @unique
  content     String
  imageUrl    String?
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model FAQ {
  id        Int      @id @default(autoincrement())
  question  String
  answer    String
  category  String?
  position  Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Giveaway {
  id          Int       @id @default(autoincrement())
  title       String
  description String
  prize       String
  imageUrl    String?
  status      String    @default("draft")  // draft | active | ended
  endsAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Review {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id])
  productId  Int
  product    Product  @relation(fields: [productId], references: [id])
  rating     Int
  comment    String?
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())
}

// ─── API KEYS ─────────────────────────────────────────────────────────────────

model ApiKey {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id])
  keyPrefix String
  keyHash   String
  label     String?
  isActive  Boolean   @default(true)
  lastUsed  DateTime?
  createdAt DateTime  @default(now())
}

// ─── SETTINGS ─────────────────────────────────────────────────────────────────

model SiteSetting {
  key   String @id
  value String
}

// ─── MESSAGING ────────────────────────────────────────────────────────────────

// One conversation per customer with the shop staff. `userId` is the customer
// who owns the thread; `senderId` is whoever wrote the message (customer or staff).
model Message {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation("MessageThread", fields: [userId], references: [id], onDelete: Cascade)
  senderId  Int?
  sender    User?     @relation("MessageSender", fields: [senderId], references: [id], onDelete: SetNull)
  isStaff   Boolean   @default(false)
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

// ─── TELEGRAM ORDERS ──────────────────────────────────────────────────────────

// An order sent as an invoice on Telegram instead of being paid from the wallet.
// Priced server-side; works for guests too.
model TelegramInvoice {
  id             Int      @id @default(autoincrement())
  code           String   @unique
  userId         Int?
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  telegramHandle String?
  contact        String?
  note           String?
  items          Json     // [{ productId, sku, name, price, quantity }]
  subtotal       Decimal  @db.Decimal(10, 2)
  shippingFee    Decimal  @default(0) @db.Decimal(10, 2)
  total          Decimal  @db.Decimal(10, 2)
  text           String
  delivered      Boolean  @default(false)  // posted to the shop's Telegram chat
  status         String   @default("new")  // new | contacted | completed | cancelled
  createdAt      DateTime @default(now())
}

// ─── TELEGRAM BOTS ────────────────────────────────────────────────────────────

// Every bot linked from Admin → Telegram. They all sell the same shop (same
// catalog, wallet and accounts); each has its own style and its own shelves.
// The primary bot posts staff notifications (paid orders, customer messages).
model TelegramBot {
  id         Int       @id @default(autoincrement())
  token      String    @unique
  username   String
  name       String
  secret     String
  isPrimary  Boolean   @default(false)
  chatId     String    @default("")   // staff chat (primary bot only)
  postChatId String    @default("")   // where new products are announced
  seenChats  Json      @default("[]") // [{ id, type, title }], newest first
  shelves    Json      @default("[]") // top-level category slugs shown; [] = all
  pgpKey     String    @default("")   // this bot's PGP public key (overrides the style's key page)
  styleId    Int?
  style      BotStyle? @relation(fields: [styleId], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now())
  users      User[]
}

// A bot's look and copy (see services/telegramStyle.js for the shape of `look`).
// Styles copied from another bot keep what was read in `capture`.
model BotStyle {
  id        Int           @id @default(autoincrement())
  name      String
  look      Json          @default("{}")
  source    String?       // @username of the bot it was copied from
  capture   Json?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  bots      TelegramBot[]
}

DATABASE_URL=postgresql://user:password@localhost:5432/scamwatch
IP_SALT=change-me
PORT=4100

# Accounts: long random string used to sign sessions
JWT_SECRET=
# Super admin account (MKO), created once at the first start, then kept as it is.
# Lost password: RESET_SUPERADMIN_PASSWORD=true for one start puts this password back.
SUPERADMIN_USERNAME=MKO
SUPERADMIN_PASSWORD=

# Wallet (same services as the shops). Addresses are derived on account 7',
# so a seed shared with a shop never collides, but a dedicated seed is better.
BTC_HD_SEED=
ETH_HD_SEED=
BLOCKCYPHER_TOKEN=
ALCHEMY_API_KEY=
ALCHEMY_WEBHOOK_ID=
ALCHEMY_AUTH_TOKEN=
ALCHEMY_SIGNING_KEY=
# Public address of this service, for the BlockCypher webhooks (e.g. https://scamwatch.example.com)
PUBLIC_URL=

# Capture of reported accounts (gives each report its type): a Telegram account dedicated
# to ScamWatch. API keys from my.telegram.org, session printed by `python capture/login.py`.
TG_API_ID=
TG_API_HASH=
TG_SESSION=
# Local runs only: Python to use (default python3, python on Windows)
# CAPTURE_PYTHON=

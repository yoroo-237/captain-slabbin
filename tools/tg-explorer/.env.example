# Copiez ce fichier en .env (même dossier) et remplissez-le.
# API_ID et API_HASH : https://my.telegram.org > API development tools
API_ID=
API_HASH=
# Numéro du compte Telegram qui parcourt les bots, au format international
PHONE=+33600000000
# Bot proposé par défaut dans l'interface (facultatif)
BOT_USERNAME=
